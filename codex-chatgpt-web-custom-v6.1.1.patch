+import { expect, test } from "bun:test";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { ChatGptWebAdapterError } from "../src/adapters/chatgpt-web/adapter-error";
+import {
+  ChatGptWebInFlightJournal,
+  type ChatGptWebInFlightDescriptor,
+} from "../src/adapters/chatgpt-web/in-flight-journal";
+import { ChatGptWebTurnRetryPolicy } from "../src/adapters/chatgpt-web/retry-policy";
+import { ChatGptWebTurnTelemetry } from "../src/adapters/chatgpt-web/turn-telemetry";
+import { compileChatGptWebPromptCached } from "../src/adapters/chatgpt-web/prompt";
+import { unsupportedChatGptWebRequestFields } from "../src/server";
+import type { CodexParsedRequest } from "../src/types";
+
+function descriptor(key: string): ChatGptWebInFlightDescriptor {
+  return {
+    key,
+    requestHash: `request-${key}`,
+    traceId: `trace-${key}`,
+    modelId: "gpt-5.6-sol",
+    purpose: "response",
+    threadId: `thread-${key}`,
+    turnId: `turn-${key}`,
+  };
+}
+
+for (const multipartParts of [2, 6] as const) {
+  test(`${multipartParts}-part journal retains replay guards across restart`, () => {
+    const root = mkdtempSync(join(tmpdir(), "cgw-in-flight-parts-"));
+    const path = join(root, "browser-in-flight.json");
+    try {
+      const journal = new ChatGptWebInFlightJournal(path, 60_000, "boot-one");
+      for (const phase of ["prepared", "sent", "accepted", "acknowledged", "completed"] as const) {
+        const handle = journal.begin(descriptor(phase));
+        handle.markPrepared({ transport: "multipart", multipartParts });
+        if (phase === "sent") handle.markSendActivated();
+        if (phase === "accepted") handle.markAccepted();
+        if (phase === "acknowledged") handle.markMultipartStageAcknowledged(1);
+        if (phase === "completed") handle.markCompleted();
+      }
+      const restarted = new ChatGptWebInFlightJournal(path, 60_000, "boot-two");
+      expect(restarted.recordsForTesting()).toHaveLength(5);
+      expect(restarted.recordsForTesting().every(record => record.multipartParts === multipartParts)).toBe(true);
+      for (const phase of ["sent", "accepted", "acknowledged"]) {
+        expect(() => restarted.begin(descriptor(phase))).toThrow("will not replay it automatically");
+      }
+      expect(() => restarted.begin(descriptor("prepared"))).not.toThrow();
+      expect(() => restarted.begin(descriptor("completed"))).not.toThrow();
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+}
+
+test("legacy three-part journal preserves acknowledged-send recovery safety", () => {
+  const root = mkdtempSync(join(tmpdir(), "cgw-in-flight-legacy-"));
+  const path = join(root, "browser-in-flight.json");
+  try {
+    const journal = new ChatGptWebInFlightJournal(path, 60_000, "boot-one");
+    const handle = journal.begin(descriptor("legacy"));
+    handle.markPrepared({ transport: "multipart", multipartParts: 6 });
+    handle.markMultipartStageAcknowledged(2);
+    const snapshot = JSON.parse(readFileSync(path, "utf8"));
+    snapshot.entries[0].multipartParts = 3;
+    writeFileSync(path, JSON.stringify(snapshot));
+    const restarted = new ChatGptWebInFlightJournal(path, 60_000, "boot-two");
+    expect(restarted.recordsForTesting()[0]?.multipartParts).toBe(3);
+    expect(() => restarted.begin(descriptor("legacy"))).toThrow("acknowledged 2 staged context part(s)");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("in-flight journal permits rebuild only before any browser side effect", () => {
+  const root = mkdtempSync(join(tmpdir(), "cgw-in-flight-test-"));
+  const path = join(root, "browser-in-flight.json");
+  try {
+    const prepared = new ChatGptWebInFlightJournal(path, 60_000, "boot-one");
+    prepared.begin(descriptor("prepared"));
+    const rebuilt = new ChatGptWebInFlightJournal(path, 60_000, "boot-two");
+    expect(() => rebuilt.begin(descriptor("prepared"))).not.toThrow();
+
+    const sent = new ChatGptWebInFlightJournal(path, 60_000, "boot-two");
+    const sentHandle = sent.begin(descriptor("sent"));
+    sentHandle.markSendActivated();
+    const afterRestart = new ChatGptWebInFlightJournal(path, 60_000, "boot-three");
+    expect(() => afterRestart.begin(descriptor("sent"))).toThrow("will not replay it automatically");
+
+    const staged = new ChatGptWebInFlightJournal(path, 60_000, "boot-three");
+    const stagedHandle = staged.begin(descriptor("staged"));
+    stagedHandle.markMultipartStageAcknowledged(1);
+    const afterStageRestart = new ChatGptWebInFlightJournal(path, 60_000, "boot-four");
+    expect(() => afterStageRestart.begin(descriptor("staged"))).toThrow("acknowledged 1 staged context part");
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("in-flight journal records terminal outcomes without blocking a deliberate retry", () => {
+  const root = mkdtempSync(join(tmpdir(), "cgw-in-flight-terminal-test-"));
+  const path = join(root, "browser-in-flight.json");
+  try {
+    const journal = new ChatGptWebInFlightJournal(path, 60_000, "boot-one");
+    const handle = journal.begin(descriptor("completed"));
+    handle.markRetryableFailure(new Error("retryable"));
+    const next = new ChatGptWebInFlightJournal(path, 60_000, "boot-two");
+    expect(() => next.begin(descriptor("completed"))).not.toThrow();
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("in-flight journal stays bounded without discarding ambiguous send records", () => {
+  const root = mkdtempSync(join(tmpdir(), "cgw-in-flight-capacity-test-"));
+  const path = join(root, "browser-in-flight.json");
+  try {
+    const journal = new ChatGptWebInFlightJournal(path, 60_000, "boot-one", 2);
+    const first = journal.begin(descriptor("first"));
+    first.markSendActivated();
+    const second = journal.begin(descriptor("second"));
+    second.markAccepted();
+
+    expect(journal.snapshot().blocked_entries).toBe(2);
+    expect(() => journal.begin(descriptor("third"))).toThrow("in-flight safety journal is full");
+    expect(journal.recordsForTesting()).toHaveLength(2);
+
+    const restarted = new ChatGptWebInFlightJournal(path, 60_000, "boot-two", 2);
+    expect(() => restarted.begin(descriptor("first"))).toThrow("will not replay it automatically");
+    expect(restarted.recordsForTesting()).toHaveLength(2);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("turn telemetry keeps bounded phase and first-output measurements", () => {
+  const telemetry = new ChatGptWebTurnTelemetry(2);
+  const handle = telemetry.start("turn-telemetry", "gpt-5.6-sol", false);
+  handle.markPrepared({ transport: "multipart", multipartParts: 6, inputTokens: 100, messageTokens: 80, maxMessageChars: 500 });
+  handle.markMultipartStageAcknowledged(1);
+  handle.markSendActivated();
+  handle.markAccepted();
+  handle.markFirstOutput();
+  handle.markCompleted();
+  handle.markCompleted();
+
+  expect(telemetry.snapshot()).toMatchObject({
+    active_turns: 0,
+    completed_turns: 1,
+    failed_turns: 0,
+    prepared_turns: 1,
+    accepted_turns: 1,
+    multipart_acknowledgements: 1,
+    first_output_observed: 1,
+  });
+  expect(telemetry.snapshot().recent[0]).toMatchObject({
+    transport: "multipart",
+    multipart_parts: 6,
+    acknowledged_parts: 1,
+    input_tokens: 100,
+    message_tokens: 80,
+    max_message_chars: 500,
+  });
+});
+
+test("retry policy applies bounded exponential delay and remains abortable", async () => {
+  const policy = new ChatGptWebTurnRetryPolicy({
+    delayBaseMs: 5,
+    delayMaxMs: 20,
+    jitterRatio: 0,
+  });
+  const error = new ChatGptWebAdapterError("temporary", {
+    status: 502,
+    errorType: "server_error",
+    code: "temporary",
+    retryable: true,
+  });
+  const now = Date.now();
+  policy.recordRetryableFailure("retry", error, now);
+  expect(policy.retryStateForTesting("retry")?.nextRetryAt).toBe(now + 5);
+  await policy.waitForRetry("retry", undefined, now);
+
+  const controller = new AbortController();
+  policy.recordRetryableFailure("retry-abort", error, now);
+  const waiting = policy.waitForRetry("retry-abort", controller.signal, now);
+  controller.abort();
+  await expect(waiting).rejects.toMatchObject({ name: "AbortError" });
+});
+
+test("prompt and token preparation reuse immutable request results", () => {
+  const parsed: CodexParsedRequest = {
+    modelId: "gpt-5.6-sol",
+    stream: false,
+    context: { messages: [{ role: "user", content: "cache this", timestamp: 1 }] },
+    options: { reasoning: "high" },
+  };
+  const capabilities = { localToolsEnabled: false, solAvailable: true, extraHighAvailable: true, proAvailable: true };
+  const first = compileChatGptWebPromptCached(parsed, capabilities);
+  const second = compileChatGptWebPromptCached(parsed, capabilities);
+  expect(second).toBe(first);
+});
+
+test("unsupported ChatGPT Web controls are reported before browser execution", () => {
+  expect(unsupportedChatGptWebRequestFields({
+    max_output_tokens: 1_000,
+    temperature: 0.2,
+    top_p: 0.8,
+    stop: ["DONE"],
+    presence_penalty: 1,
+    frequency_penalty: 1,
+    service_tier: "fast",

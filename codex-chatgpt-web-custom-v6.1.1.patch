diff --git a/launcher/electron/debugging-port.cjs b/launcher/electron/debugging-port.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..a5ffcf01242386f7738b72062a4aa0050e5c13ba
--- /dev/null
+++ b/launcher/electron/debugging-port.cjs
@@ -0,0 +1,79 @@
+const fs = require("node:fs");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+
+function allocateDebuggingPort() {
+  // A separate Node process lets the OS allocate a free port without yielding
+  // Electron's main thread before its Chromium switches have been configured.
+  const result = spawnSync(process.execPath, ["-e", `
+    const server = require("node:net").createServer();
+    server.once("error", error => { console.error(error.message); process.exitCode = 1; });
+    server.listen(0, "127.0.0.1", () => {
+      const port = server.address().port;
+      server.close(error => {
+        if (error) { console.error(error.message); process.exitCode = 1; }
+        else process.stdout.write(String(port));
+      });
+    });
+  `], {
+    env: { ...process.env, ELECTRON_RUN_AS_NODE: "1" },
+    encoding: "utf8",
+    timeout: 5_000,
+    windowsHide: true,
+  });
+  const portText = result.stdout?.trim() || "";
+  const port = Number(portText);
+  if (result.error || result.status !== 0 || !/^\d+$/.test(portText)
+    || !Number.isInteger(port) || port < 1 || port > 65535) {
+    throw new Error(`Could not allocate browser debugging port: ${result.error?.message || result.stderr?.trim() || "invalid port"}`);
+  }
+  return port;
+}
+
+// Configure before the first await. Chromium treats --remote-debugging-port=0
+// specially: it enables AutomationControlled in every renderer. Preserve the
+// prior nonzero-port behavior without restoring the async startup race.
+function configureDebuggingPort(app) {
+  if (app.isReady()) throw new Error("Browser debugging must be configured before Electron is ready");
+  const port = allocateDebuggingPort();
+  const portFile = path.join(app.getPath("sessionData"), "DevToolsActivePort");
+  // Call only after acquiring the single-instance lock. Never consume an endpoint
+  // left by a previous process or remove the running primary instance's file.
+  fs.rmSync(portFile, { force: true });
+  app.commandLine.appendSwitch("remote-debugging-address", "127.0.0.1");
+  app.commandLine.appendSwitch("remote-debugging-port", String(port));
+  return portFile;
+}
+
+async function waitForDebuggingPort(portFile, { timeoutMs = 30_000 } = {}) {
+  const deadline = Date.now() + timeoutMs;
+  let lastError = "Chromium has not published its debugging endpoint";
+  do {
+    try {
+      const [portText, browserPath] = fs.readFileSync(portFile, "utf8").trim().split(/\r?\n/);
+      const port = Number(portText);
+      if (!/^\d+$/.test(portText) || !Number.isInteger(port) || port < 1 || port > 65535
+        || !/^\/devtools\/browser\/[A-Za-z0-9-]+$/.test(browserPath || "")) {
+        throw new Error("Chromium published an invalid debugging endpoint");
+      }
+      const response = await fetch(`http://127.0.0.1:${port}/json/version`, {
+        signal: AbortSignal.timeout(Math.max(1, Math.min(1_000, deadline - Date.now()))),
+        redirect: "error",
+      });
+      if (!response.ok) throw new Error(`Browser debugging returned HTTP ${response.status}`);
+      const version = await response.json();
+      if (version.webSocketDebuggerUrl !== `ws://127.0.0.1:${port}${browserPath}`) {
+        throw new Error("Browser debugging endpoint does not match this launch's browser identity");
+      }
+      return port;
+    } catch (error) {
+      lastError = error instanceof Error ? error.message : String(error);
+    }
+    const remaining = deadline - Date.now();
+    if (remaining <= 0) break;
+    await new Promise(resolve => setTimeout(resolve, Math.min(50, remaining)));
+  } while (Date.now() < deadline);
+  throw new Error(`Browser debugging did not become ready within ${timeoutMs}ms: ${lastError}`);
+}
+
+module.exports = { configureDebuggingPort, waitForDebuggingPort };

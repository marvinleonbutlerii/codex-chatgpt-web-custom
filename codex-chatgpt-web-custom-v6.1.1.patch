new file mode 100644
index 0000000000000000000000000000000000000000..95fb107b859138002fb026564a929a85882b8fa3
--- /dev/null
+++ b/tests/skill-mcp-integration.test.ts
@@ -0,0 +1,51 @@
+import { expect, test } from "bun:test";
+import { parseRequest } from "../src/responses/parser";
+import { compileChatGptWebPrompt, compileChatGptWebPromptCached } from "../src/adapters/chatgpt-web/prompt";
+import { CHATGPT_WEB_MODEL_ID } from "../src/adapters/chatgpt-web/model";
+
+const capabilities = { localToolsEnabled: true, solAvailable: true, extraHighAvailable: true, proAvailable: true };
+const token = "turn_12345678901234567890123456789012";
+const skillText = (name: string, body: string) =>
+  `<skill>\n<name>${name}</name>\n<path>/workspace/skills/${name}/SKILL.md</path>\n${body}\n</skill>`;
+const selectedSkill = (content: string) => ({
+  role: "user",
+  content: [{ type: "input_text", text: content }],
+  internal_chat_message_metadata_passthrough: { content_item_kinds: ["skills.selected_skill_instructions"] },
+});
+const userText = (content: string) => ({
+  role: "user",
+  content: [{ type: "input_text", text: content }],
+  internal_chat_message_metadata_passthrough: { content_item_kinds: ["user.text"] },
+});
+const parse = (items: unknown[]) => parseRequest({ model: CHATGPT_WEB_MODEL_ID, input: items, reasoning: { effort: "high" } });
+
+test("cached prompts distinguish Skills-as-files from inline skill transport", () => {
+  const skill = skillText("cache-skill", "cache identity sentinel");
+  const parsed = parse([selectedSkill(skill), userText("Do it")]);
+  const inline = compileChatGptWebPromptCached(parsed, capabilities, token, { experimentalSkillAttachments: false });
+  const attached = compileChatGptWebPromptCached(parsed, capabilities, token, { experimentalSkillAttachments: true });
+  expect(inline.skillFiles).toBeUndefined();
+  expect(inline.text).toContain("cache identity sentinel");
+  expect(attached.skillFiles).toHaveLength(1);
+  expect(attached.text).not.toContain("cache identity sentinel");
+});
+
+test("MCP context transport preserves Skills-as-files attachments and their contract", () => {
+  const skill = skillText("mcp-skill", "MCP skill sentinel");
+  const parsed = parse([selectedSkill(skill), userText("Do it")]);
+  parsed.context.messages.push({
+    role: "toolResult",
+    toolCallId: "call_large",
+    toolName: "test_tool",
+    content: "x".repeat(600_000),
+    isError: false,
+    timestamp: 3,
+  });
+  const compiled = compileChatGptWebPrompt(parsed, capabilities, token, { experimentalSkillAttachments: true });
+  expect(compiled.contextTransport).toBeDefined();
+  expect(compiled.skillFiles).toHaveLength(1);
+  expect(compiled.skillFiles![0]!.text).toContain("MCP skill sentinel");
+  expect(compiled.contextTransport!.text).toContain("skill_attachment");
+  expect(compiled.contextTransport!.text).not.toContain("MCP skill sentinel");
+  expect(compiled.text).toContain("Each skill_attachment refers to a named UTF-8 text file attached to this message");
+});

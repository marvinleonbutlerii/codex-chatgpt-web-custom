+import { randomUUID } from "node:crypto";
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { atomicWriteFile, getConfigDir } from "../../config";
+import { ChatGptWebAdapterError } from "./adapter-error";
+import type { ChatGptWebTelemetryPrepared } from "./turn-telemetry";
+import { isChatGptWebMultipartPartCount, type ChatGptWebMultipartPartCount } from "./prompt";
+
+// Three-part records can remain on disk from older custom builds. Keep their replay guard even
+// though new requests use the current prompt compiler's supported part counts.
+type PersistedMultipartPartCount = ChatGptWebMultipartPartCount | 3;
+
+export type ChatGptWebInFlightPhase =
+  | "prepared"
+  | "send_activated"
+  | "accepted"
+  | "completed"
+  | "failed"
+  | "aborted";
+
+export interface ChatGptWebInFlightDescriptor {
+  key: string;
+  requestHash: string;
+  traceId: string;
+  modelId: string;
+  purpose: "response" | "compaction";
+  threadId?: string;
+  turnId?: string;
+}
+
+export interface ChatGptWebInFlightRecord extends ChatGptWebInFlightDescriptor {
+  version: 1;
+  ownerId: string;
+  phase: ChatGptWebInFlightPhase;
+  terminal: boolean;
+  uncertain: boolean;
+  acknowledgedParts: number;
+  multipartParts?: PersistedMultipartPartCount;
+  transport?: ChatGptWebTelemetryPrepared["transport"];
+  createdAt: number;
+  updatedAt: number;
+  lastError?: {
+    message: string;
+    status?: number;
+    code?: string;
+  };
+}
+
+export interface ChatGptWebInFlightJournalSnapshot {
+  active_entries: number;
+  safe_rebuild_entries: number;
+  blocked_entries: number;
+  terminal_entries: number;
+  persistence_failures: number;
+}
+
+export interface ChatGptWebInFlightHandle {
+  markPrepared(details?: ChatGptWebTelemetryPrepared): void;
+  markSendActivated(): void;
+  markAccepted(): void;
+  markMultipartStageAcknowledged(stageIndex: number): void;
+  markRetryableFailure(error: unknown): void;
+  markCompleted(): void;
+  markFailed(error: unknown): void;
+  markAborted(error?: unknown): void;
+}
+
+interface PersistedJournal {
+  version: 1;
+  entries: unknown[];
+}
+
+const JOURNAL_VERSION = 1 as const;
+const JOURNAL_TTL_MS = 24 * 60 * 60 * 1_000;
+const MAX_JOURNAL_ENTRIES = 256;
+
+function safeError(error: unknown): { message: string; status?: number; code?: string } {
+  const candidate = error && typeof error === "object"
+    ? error as { message?: unknown; status?: unknown; code?: unknown }
+    : {};
+  const message = typeof candidate.message === "string" ? candidate.message.slice(0, 500) : String(error).slice(0, 500);
+  const status = typeof candidate.status === "number" && Number.isSafeInteger(candidate.status)
+    ? candidate.status
+    : undefined;
+  const code = typeof candidate.code === "string" && /^[A-Za-z0-9_.-]{1,80}$/.test(candidate.code)
+    ? candidate.code
+    : undefined;
+  return { message, ...(status !== undefined ? { status } : {}), ...(code ? { code } : {}) };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value && typeof value === "object" && !Array.isArray(value));
+}
+
+function isPhase(value: unknown): value is ChatGptWebInFlightPhase {
+  return ["prepared", "send_activated", "accepted", "completed", "failed", "aborted"].includes(String(value));
+}
+
+function isMultipartParts(value: unknown): value is PersistedMultipartPartCount {
+  return value === 3 || (typeof value === "number" && isChatGptWebMultipartPartCount(value));
+}
+
+function parsedRecord(value: unknown): ChatGptWebInFlightRecord | undefined {
+  if (!isRecord(value)) return undefined;
+  const acknowledgedParts = value.acknowledgedParts;
+  if (value.version !== JOURNAL_VERSION
+    || typeof value.key !== "string"
+    || typeof value.requestHash !== "string"
+    || typeof value.traceId !== "string"
+    || typeof value.modelId !== "string"
+    || (value.purpose !== "response" && value.purpose !== "compaction")
+    || typeof value.ownerId !== "string"
+    || !isPhase(value.phase)
+    || typeof value.terminal !== "boolean"
+    || typeof value.uncertain !== "boolean"
+    || !Number.isSafeInteger(acknowledgedParts)
+    || (acknowledgedParts as number) < 0
+    || typeof value.createdAt !== "number"
+    || typeof value.updatedAt !== "number") return undefined;
+  if (value.multipartParts !== undefined && !isMultipartParts(value.multipartParts)) return undefined;
+  return {
+    version: JOURNAL_VERSION,
+    key: value.key,
+    requestHash: value.requestHash,
+    traceId: value.traceId,
+    modelId: value.modelId,
+    purpose: value.purpose,
+    ...(typeof value.threadId === "string" ? { threadId: value.threadId } : {}),
+    ...(typeof value.turnId === "string" ? { turnId: value.turnId } : {}),
+    ownerId: value.ownerId,
+    phase: value.phase,
+    terminal: value.terminal,
+    uncertain: value.uncertain,
+    acknowledgedParts: acknowledgedParts as number,
+    ...(value.multipartParts !== undefined ? { multipartParts: value.multipartParts } : {}),
+    ...(value.transport === "inline" || value.transport === "mcp" || value.transport === "multipart"
+      ? { transport: value.transport } : {}),
+    createdAt: value.createdAt,
+    updatedAt: value.updatedAt,
+    ...(isRecord(value.lastError) && typeof value.lastError.message === "string"
+      ? {
+          lastError: {
+            message: value.lastError.message.slice(0, 500),
+            ...(typeof value.lastError.status === "number" ? { status: value.lastError.status } : {}),
+            ...(typeof value.lastError.code === "string" ? { code: value.lastError.code } : {}),
+          },
+        }

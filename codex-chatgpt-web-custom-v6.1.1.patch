+  }
+
+  snapshot(): ChatGptWebTelemetrySnapshot {
+    return {
+      active_turns: this.active.size,
+      completed_turns: this.completedTurns,
+      failed_turns: this.failedTurns,
+      prepared_turns: this.preparedTurns,
+      accepted_turns: this.acceptedTurns,
+      multipart_acknowledgements: this.multipartAcknowledgements,
+      first_output_observed: this.firstOutputObserved,
+      recent: this.recent.map(record => ({
+        model_id: record.modelId,
+        compaction: record.compaction,
+        ...(record.transport ? { transport: record.transport } : {}),
+        ...(record.multipartParts !== undefined ? { multipart_parts: record.multipartParts } : {}),
+        acknowledged_parts: record.acknowledgedParts,
+        ...(record.inputTokens !== undefined ? { input_tokens: record.inputTokens } : {}),
+        ...(record.messageTokens !== undefined ? { message_tokens: record.messageTokens } : {}),
+        ...(record.maxMessageChars !== undefined ? { max_message_chars: record.maxMessageChars } : {}),
+        ...(record.preparedAt !== undefined ? { preparation_ms: Math.max(0, record.preparedAt - record.startedAt) } : {}),
+        ...(record.sendActivatedAt !== undefined ? { send_activation_ms: Math.max(0, record.sendActivatedAt - record.startedAt) } : {}),
+        ...(record.acceptedAt !== undefined ? { acceptance_ms: Math.max(0, record.acceptedAt - record.startedAt) } : {}),
+        duration_ms: Math.max(0, (record.terminalAt ?? record.updatedAt) - record.startedAt),
+        ...(record.firstOutputAt !== undefined
+          ? { time_to_first_output_ms: Math.max(0, record.firstOutputAt - record.startedAt) }
+          : {}),
+        ...(record.errorCode ? { error_code: record.errorCode } : {}),
+      })),
+    };
+  }
+
+  private finish(record: TurnTelemetryRecord): void {
+    if (this.active.get(record.key) === record) this.active.delete(record.key);
+    this.recent.push(record);
+    while (this.recent.length > this.maxRecent) this.recent.shift();
+  }
+}
+
+export const chatGptWebTurnTelemetry = new ChatGptWebTurnTelemetry();

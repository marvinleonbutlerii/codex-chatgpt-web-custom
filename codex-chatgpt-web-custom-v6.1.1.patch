diff --git a/launcher/tests/debugging-port.test.cjs b/launcher/tests/debugging-port.test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..95f0b7e83fa194c1fea93800227938c394017e4a
--- /dev/null
+++ b/launcher/tests/debugging-port.test.cjs
@@ -0,0 +1,69 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const http = require("node:http");
+const { configureDebuggingPort, waitForDebuggingPort } = require("../electron/debugging-port.cjs");
+
+function fixture(t) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "cgw-debugging-port-"));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  return { root, file: path.join(root, "DevToolsActivePort") };
+}
+
+test("debugging is configured synchronously and discards stale endpoint evidence", async t => {
+  const { root, file } = fixture(t);
+  fs.writeFileSync(file, "9222\n/devtools/browser/stale\n");
+  const switches = [];
+  let ready = false;
+  queueMicrotask(() => { ready = true; });
+  const result = configureDebuggingPort({
+    isReady: () => ready,
+    getPath: name => { assert.equal(name, "sessionData"); return root; },
+    commandLine: { appendSwitch: (...args) => {
+      assert.equal(ready, false);
+      switches.push(args);
+    } },
+  });
+  assert.equal(result, file);
+  assert.equal(fs.existsSync(file), false);
+  assert.equal(switches.length, 2);
+  assert.deepEqual(switches[0], ["remote-debugging-address", "127.0.0.1"]);
+  assert.equal(switches[1][0], "remote-debugging-port");
+  const port = Number(switches[1][1]);
+  assert.ok(Number.isInteger(port) && port > 0 && port <= 65535,
+    "port zero changes Chromium's renderer behavior; use an OS-allocated nonzero port");
+  await new Promise(resolve => setImmediate(resolve));
+  assert.equal(ready, true);
+});
+
+test("late debugging configuration fails before touching the active browser", () => {
+  assert.throws(() => configureDebuggingPort({ isReady: () => true }), /before Electron is ready/);
+});
+
+for (const matches of [true, false]) {
+  test(`debugging discovery verifies the published browser identity (match: ${matches})`, async t => {
+    const { file } = fixture(t);
+    const browserPath = "/devtools/browser/current-launch";
+    const server = http.createServer((req, res) => {
+      assert.equal(req.url, "/json/version");
+      res.setHeader("content-type", "application/json");
+      res.end(JSON.stringify({ webSocketDebuggerUrl: `ws://${req.headers.host}${matches ? browserPath : "/devtools/browser/stale"}` }));
+    });
+    await new Promise(resolve => server.listen(0, "127.0.0.1", resolve));
+    t.after(() => new Promise(resolve => { server.closeAllConnections(); server.close(resolve); }));
+    const port = server.address().port;
+    fs.writeFileSync(file, `${port}\n${browserPath}\n`);
+    if (matches) assert.equal(await waitForDebuggingPort(file, { timeoutMs: 500 }), port);
+    else await assert.rejects(waitForDebuggingPort(file, { timeoutMs: 60 }), /does not match this launch/);
+  });
+}
+
+test("debugging discovery waits for an incomplete file and never trusts an unbound port", async t => {
+  const { file } = fixture(t);
+  fs.writeFileSync(file, "0\n/devtools/browser/incomplete\n");
+  await assert.rejects(waitForDebuggingPort(file, { timeoutMs: 20 }), /invalid debugging endpoint/);
+  fs.rmSync(file);
+  await assert.rejects(waitForDebuggingPort(file, { timeoutMs: 20 }), /did not become ready/);
+});

+import type { ChatGptWebMultipartPartCount } from "./prompt";
+
+type TerminalTelemetryPhase = "completed" | "failed";
+
+export interface ChatGptWebTelemetryPrepared {
+  transport: "inline" | "mcp" | "multipart";
+  multipartParts?: ChatGptWebMultipartPartCount;
+  inputTokens?: number;
+  messageTokens?: number;
+  maxMessageChars?: number;
+}
+
+interface TurnTelemetryRecord {
+  readonly key: string;
+  readonly modelId: string;
+  readonly compaction: boolean;
+  readonly startedAt: number;
+  updatedAt: number;
+  preparedAt?: number;
+  sendActivatedAt?: number;
+  acceptedAt?: number;
+  firstOutputAt?: number;
+  terminalAt?: number;
+  transport?: ChatGptWebTelemetryPrepared["transport"];
+  multipartParts?: ChatGptWebMultipartPartCount;
+  acknowledgedParts: number;
+  inputTokens?: number;
+  messageTokens?: number;
+  maxMessageChars?: number;
+  phase: "started" | "prepared" | "send_activated" | "accepted" | TerminalTelemetryPhase;
+  errorCode?: string;
+}
+
+export interface ChatGptWebTelemetrySnapshot {
+  active_turns: number;
+  completed_turns: number;
+  failed_turns: number;
+  prepared_turns: number;
+  accepted_turns: number;
+  multipart_acknowledgements: number;
+  first_output_observed: number;
+  recent: Array<{
+    model_id: string;
+    compaction: boolean;
+    transport?: string;
+    multipart_parts?: number;
+    acknowledged_parts: number;
+    input_tokens?: number;
+    message_tokens?: number;
+    max_message_chars?: number;
+    preparation_ms?: number;
+    send_activation_ms?: number;
+    acceptance_ms?: number;
+    duration_ms: number;
+    time_to_first_output_ms?: number;
+    error_code?: string;
+  }>;
+}
+
+export interface ChatGptWebTelemetryHandle {
+  markPrepared(details: ChatGptWebTelemetryPrepared): void;
+  markSendActivated(): void;
+  markAccepted(): void;
+  markMultipartStageAcknowledged(stageIndex: number): void;
+  markFirstOutput(): void;
+  markCompleted(): void;
+  markFailed(error: unknown): void;
+}
+
+function safeErrorCode(error: unknown): string | undefined {
+  if (!error || typeof error !== "object") return undefined;
+  const code = (error as { code?: unknown }).code;
+  return typeof code === "string" && /^[A-Za-z0-9_.-]{1,80}$/.test(code) ? code : undefined;
+}
+
+/**
+ * Bounded, privacy-safe browser-turn telemetry. It records timings and transport shape, never
+ * prompt text, tool arguments, credentials, or browser DOM content.
+ */
+export class ChatGptWebTurnTelemetry {
+  private readonly active = new Map<string, TurnTelemetryRecord>();
+  private readonly recent: TurnTelemetryRecord[] = [];
+  private completedTurns = 0;
+  private failedTurns = 0;
+  private preparedTurns = 0;
+  private acceptedTurns = 0;
+  private multipartAcknowledgements = 0;
+  private firstOutputObserved = 0;
+
+  constructor(private readonly maxRecent = 128) {}

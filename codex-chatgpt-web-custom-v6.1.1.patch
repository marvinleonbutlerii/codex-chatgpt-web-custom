+  ): ChatGptWebTelemetryHandle {
+    const record: TurnTelemetryRecord = {
+      key,
+      modelId,
+      compaction,
+      startedAt: now,
+      updatedAt: now,
+      acknowledgedParts: 0,
+      phase: "started",
+    };
+    this.active.set(key, record);
+    let terminal = false;
+    const touch = () => { record.updatedAt = Date.now(); };
+    const handle: ChatGptWebTelemetryHandle = {
+      markPrepared: details => {
+        if (terminal) return;
+        if (record.preparedAt === undefined) {
+          record.preparedAt = Date.now();
+          this.preparedTurns += 1;
+        }
+        record.transport = details.transport;
+        if (details.multipartParts !== undefined) record.multipartParts = details.multipartParts;
+        if (details.inputTokens !== undefined) record.inputTokens = details.inputTokens;
+        if (details.messageTokens !== undefined) record.messageTokens = details.messageTokens;
+        if (details.maxMessageChars !== undefined) record.maxMessageChars = details.maxMessageChars;
+        record.phase = "prepared";
+        touch();
+      },
+      markSendActivated: () => {
+        if (terminal) return;
+        record.sendActivatedAt ??= Date.now();
+        record.phase = "send_activated";
+        touch();
+      },
+      markAccepted: () => {
+        if (terminal) return;
+        if (record.acceptedAt === undefined) {
+          record.acceptedAt = Date.now();
+          this.acceptedTurns += 1;
+        }
+        record.phase = "accepted";
+        touch();
+      },
+      markMultipartStageAcknowledged: stageIndex => {
+        if (terminal || !Number.isSafeInteger(stageIndex) || stageIndex <= record.acknowledgedParts) return;
+        record.acknowledgedParts = stageIndex;
+        this.multipartAcknowledgements += 1;
+        touch();
+      },
+      markFirstOutput: () => {
+        if (terminal || record.firstOutputAt !== undefined) return;
+        record.firstOutputAt = Date.now();
+        this.firstOutputObserved += 1;
+        touch();
+      },
+      markCompleted: () => {
+        if (terminal) return;
+        terminal = true;
+        record.phase = "completed";
+        record.terminalAt = Date.now();
+        record.updatedAt = record.terminalAt;
+        this.completedTurns += 1;
+        this.finish(record);
+      },
+      markFailed: error => {
+        if (terminal) return;
+        terminal = true;
+        record.phase = "failed";
+        record.errorCode = safeErrorCode(error);
+        record.terminalAt = Date.now();
+        record.updatedAt = record.terminalAt;
+        this.failedTurns += 1;
+        this.finish(record);
+      },
+    };

diff --git a/tests/response-state.test.ts b/tests/response-state.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4a70ddbcf60f2f653af6d9988373a5c9ee44c730
--- /dev/null
+++ b/tests/response-state.test.ts
@@ -0,0 +1,186 @@
+import { expect, test } from "bun:test";
+import { mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+
+const model = "chatgpt-web/high";
+
+function user(text: string) {
+  return { type: "message", role: "user", content: [{ type: "input_text", text }] };
+}
+
+function assistant(text: string) {
+  return { type: "message", role: "assistant", content: [{ type: "output_text", text }] };
+}
+
+async function loadState(home: string) {
+  process.env.CODEX_CHATGPT_WEB_HOME = home;
+  return import(`../src/responses/state.ts?state-test=${crypto.randomUUID()}`);
+}
+
+test("snapshot ancestry rejects cycles and missing parents without losing reverse-ordered branches", async () => {
+  const previousHome = process.env.CODEX_CHATGPT_WEB_HOME;
+  const home = mkdtempSync(join(tmpdir(), "webgpt-response-state-ancestry-"));
+  try {
+    const node = (id: string, parentId?: string) => [id, {
+      createdAt: Date.now(), items: [user(id)], ...(parentId ? { parentId } : {}),
+    }];
+    writeFileSync(join(home, "responses-state.json"), JSON.stringify({
+      version: 2,
+      states: [
+        node("leaf", "branch"), node("sibling", "root"), node("branch", "root"), node("root"),
+        node("orphan-child", "orphan"), node("orphan", "absent"),
+        node("cycle-child", "cycle-a"), node("cycle-a", "cycle-b"), node("cycle-b", "cycle-a"),
+        node("self", "self"),
+      ],
+    }));
+    const state = await loadState(home);
+    for (const [id, history] of [
+      ["leaf", ["root", "branch", "leaf"]], ["sibling", ["root", "sibling"]],
+    ] as const) {
+      const replay = state.expandPreviousResponseInput({
+        model, previous_response_id: id, input: [user("tail")],
+      }) as { input: unknown[] };
+      expect(replay.input).toEqual([...history.map(user), user("tail")]);
+    }
+    for (const id of ["orphan-child", "orphan", "cycle-child", "cycle-a", "cycle-b", "self"]) {
+      const request = { model, previous_response_id: id, input: [user("tail")] };
+      expect(state.expandPreviousResponseInput(request)).toBe(request);
+    }
+  } finally {
+    if (previousHome === undefined) delete process.env.CODEX_CHATGPT_WEB_HOME;
+    else process.env.CODEX_CHATGPT_WEB_HOME = previousHome;
+    rmSync(home, { recursive: true, force: true });
+  }
+});
+
+test("previous-response state uses structural sharing and survives restart", async () => {
+  const previousHome = process.env.CODEX_CHATGPT_WEB_HOME;
+  const home = mkdtempSync(join(tmpdir(), "webgpt-response-state-"));
+  try {
+    const state = await loadState(home);
+    const first = { model, store: false, input: [user("u1")] };
+    state.rememberResponseState(first, {
+      id: "resp_1",
+      status: "completed",
+      output: [assistant("a1")],
+    }, { force: true });
+
+    const second = state.expandPreviousResponseInput({
+      model,
+      store: false,
+      previous_response_id: "resp_1",
+      input: [user("u2")],
+    }) as { input: unknown[] };
+    expect(second.input).toEqual([user("u1"), assistant("a1"), user("u2")]);
+    expect(state.previousResponseReplayPrefixLength(second)).toBe(2);
+
+    state.rememberResponseState(second, {
+      id: "resp_2",
+      status: "completed",
+      output: [assistant("a2")],
+    }, { force: true });
+    state.flushResponseState();
+
+    const snapshot = JSON.parse(readFileSync(join(home, "responses-state.json"), "utf8")) as {
+      version: number;
+      states: Array<[string, { parentId?: string; items: unknown[]; itemCount?: number }]>;
+    };
+    expect(snapshot.version).toBe(2);
+    expect(snapshot.states.find(([id]) => id === "resp_2")?.[1]).toMatchObject({
+      parentId: "resp_1",
+      items: [user("u2"), assistant("a2")],
+      itemCount: 4,
+    });
+
+    const restarted = await loadState(home);
+    const third = restarted.expandPreviousResponseInput({
+      model,
+      store: false,
+      previous_response_id: "resp_2",
+      input: [user("u3")],
+    }) as { input: unknown[] };
+    expect(third.input).toEqual([
+      user("u1"), assistant("a1"),
+      user("u2"), assistant("a2"),
+      user("u3"),
+    ]);
+    expect(restarted.previousResponseReplayPrefixLength(third)).toBe(4);
+  } finally {
+    if (previousHome === undefined) delete process.env.CODEX_CHATGPT_WEB_HOME;
+    else process.env.CODEX_CHATGPT_WEB_HOME = previousHome;
+    rmSync(home, { recursive: true, force: true });
+  }
+});
+
+test("previous-response state remains backward compatible with version 1 snapshots", async () => {
+  const previousHome = process.env.CODEX_CHATGPT_WEB_HOME;
+  const home = mkdtempSync(join(tmpdir(), "webgpt-response-state-v1-"));
+  try {
+    writeFileSync(join(home, "responses-state.json"), JSON.stringify({
+      version: 1,
+      states: [["legacy", {
+        createdAt: Date.now(),
+        items: [user("old-u"), assistant("old-a")],
+      }]],
+    }));
+    const state = await loadState(home);
+    const expanded = state.expandPreviousResponseInput({
+      model,
+      previous_response_id: "legacy",
+      input: [user("new-u")],
+    }) as { input: unknown[] };
+    expect(expanded.input).toEqual([
+      user("old-u"), assistant("old-a"), user("new-u"),
+    ]);
+  } finally {
+    if (previousHome === undefined) delete process.env.CODEX_CHATGPT_WEB_HOME;
+    else process.env.CODEX_CHATGPT_WEB_HOME = previousHome;
+    rmSync(home, { recursive: true, force: true });
+  }
+});
+
+test("long continuation chains persist linearly while preserving exact replay", async () => {
+  const previousHome = process.env.CODEX_CHATGPT_WEB_HOME;
+  const home = mkdtempSync(join(tmpdir(), "webgpt-response-state-linear-"));
+  try {
+    const state = await loadState(home);
+    const payload = "x".repeat(4_096);
+    let previousId: string | undefined;
+    for (let i = 0; i < 120; i++) {
+      const raw: Record<string, unknown> = {
+        model,
+        store: false,
+        input: [user(`${payload}${i}`)],
+        ...(previousId ? { previous_response_id: previousId } : {}),
+      };
+      const expanded = state.expandPreviousResponseInput(raw);
+      const id = `resp_${i}`;
+      state.rememberResponseState(expanded, {
+        id,
+        status: "completed",
+        output: [assistant(`a${i}`)],
+      }, { force: true });
+      previousId = id;
+    }
+    state.flushResponseState();
+
+    const snapshotPath = join(home, "responses-state.json");
+    expect(statSync(snapshotPath).size).toBeLessThan(2 * 1024 * 1024);
+
+    const restarted = await loadState(home);
+    const replayed = restarted.expandPreviousResponseInput({
+      model,
+      previous_response_id: previousId,
+      input: [user("tail")],
+    }) as { input: unknown[] };
+    expect(replayed.input).toHaveLength(241);
+    expect(replayed.input[0]).toEqual(user( `${payload}0`));
+    expect(replayed.input.at(-2)).toEqual(assistant("a119"));
+    expect(replayed.input.at(-1)).toEqual(user("tail"));
+  } finally {
+    if (previousHome === undefined) delete process.env.CODEX_CHATGPT_WEB_HOME;
+    else process.env.CODEX_CHATGPT_WEB_HOME = previousHome;
+    rmSync(home, { recursive: true, force: true });
+  }
+});

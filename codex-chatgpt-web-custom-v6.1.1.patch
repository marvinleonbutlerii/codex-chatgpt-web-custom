diff --git a/src/tool-registry.ts b/src/tool-registry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc04e4b9c16f2386ffb8732b44b428e1981ce124
--- /dev/null
+++ b/src/tool-registry.ts
@@ -0,0 +1,132 @@
+import { namespacedToolName, type CodexTool } from "./types";
+
+export type CodexToolKind = "function" | "freeform" | "tool_search";
+
+export interface CanonicalToolDescriptor {
+  wireName: string;
+  name: string;
+  description: string;
+  namespace?: string;
+  kind: CodexToolKind;
+  parameters: Record<string, unknown>;
+  strict?: boolean;
+  outputSchema?: Record<string, unknown>;
+  format?: Record<string, unknown>;
+  annotations?: CodexTool["annotations"];
+  execution?: unknown;
+  protocolType?: string;
+  source?: CodexTool["source"];
+}
+
+export type CanonicalToolIndex = ReadonlyMap<string, CanonicalToolDescriptor>;
+
+function toolSearchTerms(query: string): string[] {
+  const normalized = query.trim().toLowerCase();
+  if (!normalized) return [];
+  return normalized.match(/[a-z0-9_$]+/g) ?? [normalized];
+}
+
+export function canonicalToolSearchRank(
+  tool: Pick<CanonicalToolDescriptor, "wireName" | "name" | "namespace" | "description">,
+  query: string | undefined,
+): number | undefined {
+  const needle = query?.trim().toLowerCase() ?? "";
+  if (!needle) return 0;
+  const wireName = tool.wireName.toLowerCase();
+  const name = tool.name.toLowerCase();
+  const namespace = tool.namespace?.toLowerCase() ?? "";
+  const description = tool.description.toLowerCase();
+  const searchText = `${wireName}\n${name}\n${namespace}\n${description}`;
+  const terms = toolSearchTerms(needle);
+  if (!terms.every(term => searchText.includes(term))) return undefined;
+
+  let score = 0;
+  if (wireName === needle) score += 10_000;
+  if (name === needle) score += 9_000;
+  if (wireName.startsWith(needle)) score += 4_000;
+  if (name.startsWith(needle)) score += 3_500;
+  if (wireName.includes(needle)) score += 2_000;
+  if (name.includes(needle)) score += 1_800;
+  if (namespace.includes(needle)) score += 1_000;
+  if (description.includes(needle)) score += 700;
+  for (const term of terms) {
+    if (wireName.includes(term)) score += 120;
+    if (name.includes(term)) score += 100;
+    if (namespace.includes(term)) score += 60;
+    if (description.includes(term)) score += 25;
+  }
+  return score;
+}
+
+export function searchCanonicalTools(
+  tools: Iterable<CanonicalToolDescriptor>,
+  query: string | undefined,
+): CanonicalToolDescriptor[] {
+  return [...tools]
+    .map((tool, index) => ({ tool, index, rank: canonicalToolSearchRank(tool, query) }))
+    .filter((entry): entry is { tool: CanonicalToolDescriptor; index: number; rank: number } => entry.rank !== undefined)
+    .sort((left, right) => right.rank - left.rank || left.index - right.index)
+    .map(entry => entry.tool);
+}
+
+function immutableDescriptor<T>(value: T): T {
+  const freeze = (candidate: unknown): void => {
+    if (!candidate || typeof candidate !== "object" || Object.isFrozen(candidate)) return;
+    for (const nested of Object.values(candidate as Record<string, unknown>)) freeze(nested);
+    Object.freeze(candidate);
+  };
+  freeze(value);
+  return value;
+}
+
+export function codexToolKind(tool: CodexTool): CodexToolKind {
+  if (tool.toolSearch) return "tool_search";
+  if (tool.freeform) return "freeform";
+  return "function";
+}
+
+export function canonicalToolDescriptor(tool: CodexTool): CanonicalToolDescriptor {
+  return immutableDescriptor({
+    wireName: namespacedToolName(tool.namespace, tool.name),
+    name: tool.name,
+    description: tool.description,
+    ...(tool.namespace ? { namespace: tool.namespace } : {}),
+    kind: codexToolKind(tool),
+    parameters: structuredClone(tool.parameters),
+    ...(tool.strict !== undefined ? { strict: tool.strict } : {}),
+    ...(tool.outputSchema ? { outputSchema: structuredClone(tool.outputSchema) } : {}),
+    ...(tool.format ? { format: structuredClone(tool.format) } : {}),
+    ...(tool.annotations ? { annotations: structuredClone(tool.annotations) } : {}),
+    ...(tool.execution !== undefined ? { execution: structuredClone(tool.execution) } : {}),
+    ...(tool.protocolType ? { protocolType: tool.protocolType } : {}),
+    ...(tool.source ? { source: tool.source } : {}),
+  });
+}
+
+export function buildCanonicalToolIndex(tools: readonly CodexTool[] | undefined): CanonicalToolIndex {
+  const index = new Map<string, CanonicalToolDescriptor>();
+  for (const tool of tools ?? []) {
+    const descriptor = canonicalToolDescriptor(tool);
+    if (index.has(descriptor.wireName)) {
+      throw new Error(`Duplicate Codex tool wire identity: ${descriptor.wireName}`);
+    }
+    index.set(descriptor.wireName, descriptor);
+  }
+  return index;
+}
+
+export function resolveCanonicalTool(
+  index: CanonicalToolIndex | undefined,
+  wireName: string,
+): CanonicalToolDescriptor {
+  const descriptor = index?.get(wireName);
+  if (descriptor) return descriptor;
+  if (index) throw new Error(`Codex tool is not present in the canonical registry: ${wireName}`);
+  return {
+    wireName,
+    name: wireName,
+    description: "",
+    kind: "function",
+    parameters: {},
+  };
+}

+import { expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import {
+  CHATGPT_WEB_MCP_CONTEXT_CHUNK_CHARS,
+  assertChatGptWebMcpContextTransport,
+  chatGptWebMcpContextChunk,
+  chatGptWebMcpContextChunks,
+  createChatGptWebMcpContextTransport,
+} from "../src/adapters/chatgpt-web/context-transport";
+
+test("repeated context reads preserve Unicode, hashes, and private chunk storage", () => {
+  const text = "a".repeat(CHATGPT_WEB_MCP_CONTEXT_CHUNK_CHARS - 1) + "😀" + "β".repeat(70_000);
+  const context = assertChatGptWebMcpContextTransport(createChatGptWebMcpContextTransport(text));
+  const chunks = chatGptWebMcpContextChunks(context);
+  expect(Object.isFrozen(context)).toBe(true);
+  expect(chunks[0]!.length).toBe(CHATGPT_WEB_MCP_CONTEXT_CHUNK_CHARS - 1);
+  expect(chunks[1]!.startsWith("😀")).toBe(true);
+  expect(chunks.join("")).toBe(text);
+  expect(createHash("sha256").update(chunks.join(""), "utf8").digest("hex")).toBe(context.sha256);
+  const expected = [...chunks];
+  chunks[0] = "caller mutation";
+  chunks.push("extra chunk");
+  for (const index of [2, 0, 1, 2, 3, 0]) {
+    expect(chatGptWebMcpContextChunk(context, context.contextId, index)).toMatchObject({
+      text: expected[index],
+      total_chunks: expected.length,
+      next_chunk: index + 1 < expected.length ? index + 1 : null,
+    });
+  }
+  expect(chatGptWebMcpContextChunks(context)).toEqual(expected);
+  expect(() => chatGptWebMcpContextChunk(context, "wrong-context", 0)).toThrow("context id");
+  for (const index of [-1, 0.5, expected.length]) {
+    expect(() => chatGptWebMcpContextChunk(context, context.contextId, index)).toThrow("chunk");
+  }
+});
+
+test("mutable transport copies do not receive stale cached chunks", () => {
+  const context = { ...createChatGptWebMcpContextTransport("before") };
+  expect(chatGptWebMcpContextChunks(context)).toEqual(["before"]);
+  Object.assign(context, createChatGptWebMcpContextTransport("after"));
+  expect(chatGptWebMcpContextChunk(context, context.contextId, 0).text).toBe("after");
+});

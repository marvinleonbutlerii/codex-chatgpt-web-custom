new file mode 100644
index 0000000000000000000000000000000000000000..a10a1ae8819cc69571060b8273db60a10c2771a6
--- /dev/null
+++ b/tests/tool-registry.test.ts
@@ -0,0 +1,110 @@
+import { expect, test } from "bun:test";
+import { buildCanonicalToolIndex, resolveCanonicalTool, searchCanonicalTools } from "../src/tool-registry";
+import type { CodexTool } from "../src/types";
+
+test("canonical tool registry resolves same-name namespace collisions by exact wire identity", () => {
+  const index = buildCanonicalToolIndex([{
+    namespace: "mcp__python",
+    name: "run_script",
+    description: "Freeform Python",
+    parameters: {},
+    freeform: true,
+  }, {
+    namespace: "mcp__other",
+    name: "run_script",
+    description: "Structured runner",
+    parameters: { type: "object" },
+  }]);
+
+  expect(resolveCanonicalTool(index, "mcp__python__run_script")).toMatchObject({
+    wireName: "mcp__python__run_script",
+    namespace: "mcp__python",
+    name: "run_script",
+    kind: "freeform",
+  });
+  expect(resolveCanonicalTool(index, "mcp__other__run_script")).toMatchObject({
+    wireName: "mcp__other__run_script",
+    namespace: "mcp__other",
+    name: "run_script",
+    kind: "function",
+  });
+});
+
+test("canonical tool registry fails closed on duplicate wire identities", () => {
+  const duplicate: CodexTool[] = [{
+    namespace: "mcp__python",
+    name: "run_script",
+    description: "first",
+    parameters: {},
+  }, {
+    namespace: "mcp__python",
+    name: "run_script",
+    description: "second",
+    parameters: {},
+    freeform: true,
+  }];
+
+  expect(() => buildCanonicalToolIndex(duplicate)).toThrow("Duplicate Codex tool wire identity: mcp__python__run_script");
+});
+
+test("canonical tool resolution fails closed for an unknown tool when a registry exists", () => {
+  const index = buildCanonicalToolIndex([{
+    name: "known",
+    description: "Known",
+    parameters: {},
+  }]);
+
+  expect(() => resolveCanonicalTool(index, "unknown"))
+    .toThrow("Codex tool is not present in the canonical registry: unknown");
+});
+
+test("canonical descriptors snapshot schemas and annotations instead of sharing mutable source objects", () => {
+  const tool: CodexTool = {
+    name: "lookup",
+    description: "Lookup",
+    parameters: { type: "object", properties: { q: { type: "string" } } },
+    annotations: { readOnlyHint: true },
+    execution: { taskSupport: "optional" },
+  };
+  const index = buildCanonicalToolIndex([tool]);
+
+  (tool.parameters.properties as Record<string, unknown>).q = { type: "number" };
+  tool.annotations!.readOnlyHint = false;
+  (tool.execution as Record<string, unknown>).taskSupport = "required";
+
+  const descriptor = index.get("lookup")!;
+  expect(descriptor).toMatchObject({
+    parameters: { type: "object", properties: { q: { type: "string" } } },
+    annotations: { readOnlyHint: true },
+    execution: { taskSupport: "optional" },
+  });
+  expect(Object.isFrozen(descriptor)).toBe(true);
+  expect(Object.isFrozen(descriptor.parameters)).toBe(true);
+  expect(Object.isFrozen(descriptor.parameters.properties)).toBe(true);
+  expect(Object.isFrozen(descriptor.annotations)).toBe(true);
+  expect(Object.isFrozen(descriptor.execution)).toBe(true);
+});
+
+test("canonical tool search ranks exact identities first and matches multi-keyword intent", () => {
+  const index = buildCanonicalToolIndex([{
+    name: "generic_search",
+    description: "Search many external systems including GitHub repositories",
+    parameters: {},
+  }, {
+    namespace: "github",
+    name: "search_issues",
+    description: "Find issues and pull requests in GitHub repositories",
+    parameters: {},
+  }, {
+    namespace: "github",
+    name: "fetch_issue",
+    description: "Fetch one GitHub issue",
+    parameters: {},
+  }]);
+
+  expect(searchCanonicalTools(index.values(), "github search issue").map(tool => tool.wireName)).toEqual([
+    "github__search_issues",
+  ]);
+  expect(searchCanonicalTools(index.values(), "github__fetch_issue").map(tool => tool.wireName)[0])
+    .toBe("github__fetch_issue");
+});

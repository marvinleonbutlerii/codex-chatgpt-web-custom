+function recoveryMessage(record: ChatGptWebInFlightRecord): string {
+  const status = record.phase === "accepted"
+    ? "ChatGPT accepted the prompt"
+    : record.acknowledgedParts > 0
+      ? `ChatGPT acknowledged ${record.acknowledgedParts} staged context part(s)`
+      : "the prompt send boundary became ambiguous";
+  return `A previous ChatGPT Web turn is still uncertain: ${status}. `
+    + "The bridge will not replay it automatically because that could duplicate the task. "
+    + "Inspect the ChatGPT tab, finish or cancel the existing turn, then retry from a new Codex turn.";
+}
+
+export class ChatGptWebInFlightRecoveryError extends ChatGptWebAdapterError {
+  constructor(record: ChatGptWebInFlightRecord) {
+    super(recoveryMessage(record), {
+      status: 409,
+      errorType: "invalid_request_error",
+      code: "in_flight_turn_uncertain",
+      retryable: false,
+    });
+  }
+}
+
+/**
+ * A small durable sidecar for browser effects. Only the exact request identity and phase markers
+ * are stored. A recovered turn is rebuildable only before any send or staged acknowledgement;
+ * every later state fails closed to prevent duplicate prompts or tool calls after a crash.
+ */
+export class ChatGptWebInFlightJournal {
+  private readonly records = new Map<string, ChatGptWebInFlightRecord>();
+  private readonly ownerId: string;
+  private persistenceFailures = 0;
+
+  constructor(
+    private readonly path = join(getConfigDir(), "browser-in-flight.json"),
+    private readonly ttlMs = JOURNAL_TTL_MS,
+    ownerId: string = randomUUID(),
+    private readonly maxEntries = MAX_JOURNAL_ENTRIES,
+  ) {
+    if (!Number.isSafeInteger(this.maxEntries) || this.maxEntries < 1) {
+      throw new Error("ChatGPT Web in-flight journal capacity must be a positive safe integer");
+    }
+    this.ownerId = ownerId;
+    this.load();
+  }
+
+  begin(descriptor: ChatGptWebInFlightDescriptor, now = Date.now()): ChatGptWebInFlightHandle {
+    this.prune(now);
+    const existing = this.records.get(descriptor.key);
+    if (existing && !existing.terminal) {
+      if (existing.ownerId !== this.ownerId) {
+        if (this.safeToRebuild(existing)) {
+          this.records.delete(descriptor.key);
+        } else {
+          throw new ChatGptWebInFlightRecoveryError(existing);
+        }
+      } else if (existing.uncertain || !this.safeToRebuild(existing)) {
+        throw new ChatGptWebInFlightRecoveryError(existing);
+      } else {
+        return this.handle(existing.key);
+      }
+    }
+    if (!this.records.has(descriptor.key)) {
+      while (this.records.size >= this.maxEntries) {
+        const candidate = [...this.records.values()]
+          .filter(record => record.terminal)
+          .sort((left, right) => left.updatedAt - right.updatedAt)[0];
+        if (!candidate) break;
+        this.records.delete(candidate.key);
+      }
+      if (this.records.size >= this.maxEntries) {
+        throw new ChatGptWebAdapterError("ChatGPT Web in-flight safety journal is full; unresolved ambiguous turns cannot be discarded safely", {
+          status: 503,
+          errorType: "server_error",
+          code: "in_flight_journal_full",
+          retryable: false,
+        });
+      }
+    }
+    const record: ChatGptWebInFlightRecord = {
+      version: JOURNAL_VERSION,
+      ...descriptor,
+      ownerId: this.ownerId,
+      phase: "prepared",
+      terminal: false,
+      uncertain: false,
+      acknowledgedParts: 0,
+      createdAt: now,
+      updatedAt: now,
+    };
+    this.records.set(descriptor.key, record);
+    this.persist(now);
+    return this.handle(descriptor.key);
+  }
+
+  snapshot(now = Date.now()): ChatGptWebInFlightJournalSnapshot {
+    this.prune(now);
+    let safe = 0;
+    let blocked = 0;
+    let terminal = 0;
+    for (const record of this.records.values()) {
+      if (record.terminal) terminal += 1;
+      else if (this.safeToRebuild(record)) safe += 1;
+      else blocked += 1;
+    }
+    return {
+      active_entries: safe + blocked,
+      safe_rebuild_entries: safe,
+      blocked_entries: blocked,
+      terminal_entries: terminal,
+      persistence_failures: this.persistenceFailures,
+    };
+  }
+
+  recordsForTesting(): ChatGptWebInFlightRecord[] {
+    return [...this.records.values()].map(record => structuredClone(record));
+  }
+
+  private handle(key: string): ChatGptWebInFlightHandle {
+    const update = (mutate: (record: ChatGptWebInFlightRecord) => void): void => {
+      const record = this.records.get(key);
+      if (!record || record.terminal) return;
+      mutate(record);
+      record.updatedAt = Date.now();
+      this.persist(record.updatedAt);
+    };
+    return {
+      markPrepared: details => update(record => {
+        record.phase = "prepared";
+        record.uncertain = false;
+        if (details?.transport) record.transport = details.transport;
+        if (details?.multipartParts !== undefined) record.multipartParts = details.multipartParts;
+      }),
+      markSendActivated: () => update(record => {
+        record.phase = "send_activated";
+        record.uncertain = true;
+      }),
+      markAccepted: () => update(record => {
+        record.phase = "accepted";
+        record.uncertain = true;
+      }),
+      markMultipartStageAcknowledged: stageIndex => update(record => {
+        if (Number.isSafeInteger(stageIndex) && stageIndex > record.acknowledgedParts) {
+          record.acknowledgedParts = stageIndex;
+          record.uncertain = true;
+        }
+      }),
+      // A classified retryable ChatGPT failure is an explicit transport/UI outcome. The existing
+      // retry policy is therefore allowed to start a fresh attempt in this process; a restart
+      // still fails closed if it occurs before this marker is durably written.
+      markRetryableFailure: error => update(record => {
+        record.lastError = safeError(error);
+        record.phase = "failed";
+        record.terminal = true;
+        record.uncertain = false;
+      }),
+      markCompleted: () => update(record => {
+        record.phase = "completed";
+        record.terminal = true;
+        record.uncertain = false;
+      }),
+      markFailed: error => update(record => {
+        record.lastError = safeError(error);
+        if (this.safeToRebuild(record)) {
+          record.phase = "failed";
+          record.terminal = true;
+          record.uncertain = false;
+        } else {
+          record.uncertain = true;
+        }
+      }),
+      markAborted: error => update(record => {
+        if (error !== undefined) record.lastError = safeError(error);
+        if (this.safeToRebuild(record)) {
+          record.phase = "aborted";
+          record.terminal = true;
+          record.uncertain = false;
+        } else {
+          record.uncertain = true;
+        }
+      }),
+    };
+  }
+
+  private safeToRebuild(record: ChatGptWebInFlightRecord): boolean {
+    return !record.terminal && !record.uncertain && record.phase === "prepared" && record.acknowledgedParts === 0;
+  }
+
+  private load(): void {
+    if (!existsSync(this.path)) return;
+    try {
+      const raw = JSON.parse(readFileSync(this.path, "utf8")) as Partial<PersistedJournal>;
+      if (raw.version !== JOURNAL_VERSION || !Array.isArray(raw.entries)) return;
+      for (const item of raw.entries) {
+        const record = parsedRecord(item);
+        if (record) this.records.set(record.key, record);
+      }
+      this.prune(Date.now());
+    } catch {
+      // A corrupt sidecar must never prevent the bridge from starting. The next successful update
+      // replaces it with a valid bounded snapshot.
+    }
+  }
+
+  private prune(now: number): void {
+    const cutoff = now - this.ttlMs;
+    for (const [key, record] of this.records) {
+      if (record.terminal && record.updatedAt < cutoff) this.records.delete(key);
+    }
+    while (this.records.size > this.maxEntries) {
+      const candidate = [...this.records.values()]
+        .filter(record => record.terminal)
+        .sort((left, right) => left.updatedAt - right.updatedAt)[0];
+      if (!candidate) break;
+      this.records.delete(candidate.key);
+    }
+  }
+
+  private persist(now: number): void {
+    this.prune(now);
+    try {
+      const entries = [...this.records.values()].map(record => ({ ...record }));
+      atomicWriteFile(this.path, `${JSON.stringify({ version: JOURNAL_VERSION, entries }, null, 2)}\n`);
+    } catch (error) {
+      this.persistenceFailures += 1;
+      console.warn(`[chatgpt-web] could not persist browser in-flight journal: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  }
+}
+
+export const chatGptWebInFlightJournal = new ChatGptWebInFlightJournal();
